# Flinks credentials — get these from your Flinks dashboard
# Sandbox (toolbox) values are pre-filled for local testing
FLINKS_CUSTOMER_ID=43387ca6-0391-4c82-857d-70d95f087ecb
FLINKS_SECRET_KEY=your_secret_key_here

# API base URL — toolbox (sandbox) or your production instance
FLINKS_API_URL=https://toolbox-api.private.fin.ag
# iframe base URL — used by iOS WebView to present the bank login UI
FLINKS_IFRAME_URL=https://toolbox-iframe.private.fin.ag

# Port for the Express server
PORT=3000
