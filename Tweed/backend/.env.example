# ─── Gmail (required) ─────────────────────────────────────────────────────────
# The server reads Scotiabank alert emails over the Gmail API. Create an OAuth
# client (type: Web application) in the Google Cloud console, enable the Gmail
# API, and add the redirect URI below to that client's authorised redirect URIs.
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Port for the Express server
PORT=3000

# ─── Flinks (unused) ──────────────────────────────────────────────────────────
# src/flinks.js is left over from the earlier bank-aggregator approach. Nothing
# in src/index.js imports it, and it requires `axios`, which is not installed —
# so these are not needed to run the server as it stands.
# FLINKS_CUSTOMER_ID=
# FLINKS_SECRET_KEY=
# FLINKS_API_KEY=
# FLINKS_API_URL=https://toolbox-api.private.fin.ag
# FLINKS_IFRAME_URL=https://toolbox-iframe.private.fin.ag
